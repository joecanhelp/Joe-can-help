* C:\Users\joe.chang\OneDrive\_website\joe-can-help\docs\assets\models\tps40200_part3_OSC_Ramp.sxsch
.node_map RC 20
.node_map CLK 21
.node_map VIN 19
.options PSP_NPT=10001 POP_ITRMAX=20 POP_OUTPUT_CYCLES=5 SNAPSHOT_INTVL=0 SNAPSHOT_NPT=11
+ MIN_AVG_TOPOLOGY_DUR=1a AVG_TOPOLOGY_DUR_MEASUREMENT_WINDOW=128
.tran 1m 0
C1 20 0 4.7e-10 IC=0
.PRINT V(#CLK)
.GRAPH :#CLK axisType="digital" persistence=-1 curveLabel="CLK" analysis="tran|pop"
+ xLog="auto" yLog="auto"  nowarn=true disabled=false PROBEREF=Probe1  
.PRINT V(#RC)
.GRAPH :#RC curveLabel= RC nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false
+ PROBEREF=Probe2  
R1 19 20 100000
R2 19 14 100k
R3 14 0 11.11k
X$S1 20 0 21 0 VC_SWITCH_V2$1
X$U1 12 15 0 20 14 SIMPLIS_DIGI1_COMP_Y$2
X$U2 13 18 0 17 20 SIMPLIS_DIGI1_COMP_Y$3
X$U3 21 16 0 12 13 SIMPLIS_DIGI1_SRLATCH_Y$4
V1 17 0 150m
V2 19 0 12
.subckt SIMPLIS_DIGI1_SRLATCH_Y$4  201 202 100 101 102
.NODE_MAP Q    201
.NODE_MAP QN   202
.NODE_MAP RTN  100
.NODE_MAP S    101
.NODE_MAP R    102
A_SRLATCH  %gnd_ref 100 [ 201 202 ] [ 101 102 ] MODEL=MD_SRLATCHM IC=0
.MODEL MD_SRLATCHM DIGITAL1 D_SRLATCH  RIN=10000000 TH=2.5 HYSTWD=1  ROUT=10 VOL=0
+ VOH=5  OUT_DELAY=2e-11  SET_RESET_LEVEL=1  DOM=NONE
.ends SIMPLIS_DIGI1_SRLATCH_Y$4

.subckt SIMPLIS_DIGI1_COMP_Y$3  201 202 100 101 102
.NODE_MAP OUT 201
.NODE_MAP OUT_BAR 202
.NODE_MAP RTN 100
.NODE_MAP INP 101
.NODE_MAP INN 102
R_INP  101 100 10000000
R_INN  102 100 10000000
E_DIFF 103 100 101 102 1.0
A_COMP %gnd_ref 100 [ 201 202 ] [ 103 ] MODEL=MD_A_COMPM IC=0
.MODEL MD_A_COMPM DIGITAL1 D_BUFFER ROUT=10 VOL=0 VOH=5  RIN=10000000 TH=0.0 HYSTWD=0.002
+  OUT_DELAY=2e-12
.ends SIMPLIS_DIGI1_COMP_Y$3

.subckt SIMPLIS_DIGI1_COMP_Y$2  201 202 100 101 102
.NODE_MAP OUT 201
.NODE_MAP OUT_BAR 202
.NODE_MAP RTN 100
.NODE_MAP INP 101
.NODE_MAP INN 102
R_INP  101 100 10000000
R_INN  102 100 10000000
E_DIFF 103 100 101 102 1.0
A_COMP %gnd_ref 100 [ 201 202 ] [ 103 ] MODEL=MD_A_COMPM IC=0
.MODEL MD_A_COMPM DIGITAL1 D_BUFFER ROUT=10 VOL=0 VOH=5  RIN=10000000 TH=0.0 HYSTWD=0.002
+  OUT_DELAY=2e-12
.ends SIMPLIS_DIGI1_COMP_Y$2

.subckt VC_SWITCH_V2$1  1 2 3 4
.NODE_MAP P 1
.NODE_MAP N 2
.NODE_MAP CP 3
.NODE_MAP CN 4
S1 1 2 3 4 SW IC=OPEN
.MODEL SW VCSW ROFF=1000000 RON=1 TH=2 HYSTWD=0.1 LOGIC=POS
.ends VC_SWITCH_V2$1

.end

